{
	"name": "clone",
	"version": "1.0.0",
	"description": "Configurable JS/TS cloning and deepcloning utility ",
	"license": "MIT",
	"author": {
		"email": "levyvandervalk@gmail.com",
		"name": "Levy van der Valk"
	},
	"contributors": [
		{
			"email": "levyvandervalk@gmail.com",
			"name": "Levy van der Valk"
		},
		{
			"email": "levypondman@live.nl",
			"name": "Levy Pondman"
		}
	],
	"keywords": [
		"javascript",
		"typescript",
		"clone",
		"cloner",
		"cloning",
		"deepclone",
		"deepcloner",
		"deepcloning"
	],
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "dist/clone.cjs",
	"module": "dist/clone.js",
	"types": "dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/clone.js",
		"require": "./dist/clone.cjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Catstral/clone.git"
	},
	"scripts": {
		"dev": "vite",
		"compile": "tsc && bun test && vite build",
		"preview": "vite preview",
		"production": "bun compile && npm publish",
		"tsc": "tsc --noEmit --diagnostics",
		"lint": "biome check . --formatter-enabled=true",
		"lint:apply": "biome check . --formatter-enabled=true --write",
		"lint:apply:unsafe": "biome check . --formatter-enabled=true --write --unsafe",
		"check": "bun tsc && bun lint"
	},
	"devDependencies": {
		"@types/bun": "1.3.2",
		"@biomejs/biome": "2.5.4",
		"@typescript/typescript6": "^6.0.2",
		"typescript": "^7.0.0",
		"vite": "^8.1.5",
		"vite-plugin-dts": "^5.0.3"
	}
}
